{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-map.schema.json",
  "title": "Report-to-claim map",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_map_id", "report_units"],
  "properties": {
    "report_map_id": { "type": "string", "pattern": "^rmap_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "report_units": { "type": "array", "items": { "$ref": "#/$defs/reportUnit" } }
  },
  "$defs": {
    "reportUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_unit_id", "section", "claim_ids"],
      "properties": {
        "report_unit_id": { "type": "string", "pattern": "^rpt_[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "section": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "claim.schema.json#/$defs/claimId" } },
        "is_inference": { "type": "boolean" },
        "premise_claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "claim.schema.json#/$defs/claimId" } }
      },
      "allOf": [{ "if": { "properties": { "is_inference": { "const": true } }, "required": ["is_inference"] }, "then": { "required": ["premise_claim_ids"] } }]
    }
  }
}
