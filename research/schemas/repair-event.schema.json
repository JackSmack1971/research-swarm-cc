{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-event.schema.json",
  "title": "Semantic repair event",
  "type": "object",
  "additionalProperties": false,
  "required": ["repair_event_id", "occurred_at", "repair_round", "defect_ids", "outcome"],
  "properties": {
    "repair_event_id": { "type": "string", "pattern": "^rep_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "repair_round": { "type": "integer", "minimum": 1, "maximum": 2 },
    "defect_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^def_[A-Za-z0-9][A-Za-z0-9_-]*$" } },
    "outcome": { "enum": ["completed", "exhausted"] }
  }
}
