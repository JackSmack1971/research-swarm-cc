{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-snapshot.schema.json",
  "title": "Archived adaptive policy snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_snapshot_id", "policy_bundle", "constitution_version", "created_at"],
  "properties": { "policy_snapshot_id": { "type": "string", "pattern": "^psn_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "policy_bundle": { "$ref": "policy-bundle.schema.json" }, "constitution_version": { "type": "string", "minLength": 1 }, "created_at": { "type": "string", "format": "date-time" } }
}
