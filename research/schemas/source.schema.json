{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Research source",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "title", "publisher", "publication_date", "source_type", "independence_group", "access_date"],
  "properties": {
    "source_id": { "$ref": "#/$defs/sourceId" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1, "description": "Responsible organization or publisher." },
    "publication_date": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
    "publication_date_unavailable_reason": { "type": "string", "minLength": 1, "description": "Required only when a genuine search could not establish a publication date." },
    "url": { "type": "string", "format": "uri", "minLength": 1 },
    "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
    "source_type": { "$ref": "#/$defs/sourceType" },
    "independence_group": { "type": "string", "pattern": "^ig_[A-Za-z0-9][A-Za-z0-9_-]*$", "description": "Sources derived from one origin share this ID." },
    "access_date": { "type": "string", "format": "date" }
  },
  "allOf": [
    { "anyOf": [{ "required": ["url"] }, { "required": ["doi"] }] },
    { "if": { "properties": { "publication_date": { "type": "null" } }, "required": ["publication_date"] }, "then": { "required": ["publication_date_unavailable_reason"] }, "else": { "not": { "required": ["publication_date_unavailable_reason"] } } }
  ],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "sourceType": { "enum": ["primary_data", "official_record", "standard", "filing", "academic_research", "secondary_analysis", "expert_commentary", "general_commentary", "repository", "other"] }
  }
}
