{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Canonical research claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "statement", "scope", "claim_type", "materiality", "confidence", "confidence_rationale", "supporting_evidence", "counter_evidence"],
  "properties": {
    "claim_id": { "$ref": "#/$defs/claimId" },
    "statement": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1, "description": "Population, period, geography, conditions, and limitations covered by the claim." },
    "claim_type": { "$ref": "#/$defs/claimType" },
    "materiality": { "$ref": "#/$defs/materiality" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "confidence_rationale": { "type": "string", "minLength": 1 },
    "supporting_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "counter_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "premise_claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimId" }, "description": "Required for an inference; identifies its premise claims." }
  },
  "allOf": [
    { "if": { "properties": { "claim_type": { "const": "inference" } }, "required": ["claim_type"] }, "then": { "required": ["premise_claim_ids"] }, "else": { "not": { "required": ["premise_claim_ids"] } } }
  ],
  "$defs": {
    "claimId": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "claimType": { "enum": ["fact", "source_assertion", "estimate", "opinion", "inference"] },
    "materiality": { "enum": ["critical", "high", "medium", "low"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "relationship"],
      "properties": {
        "source_id": { "$ref": "source.schema.json#/$defs/sourceId" },
        "locator": { "type": "string", "minLength": 1, "description": "Section, heading, page, table, paragraph description, timestamp, or repository path." },
        "relationship": { "enum": ["supports", "contradicts", "qualifies"] },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
