{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-need.schema.json",
  "title": "Engineering knowledge need",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "knowledge_need_id", "question", "why_it_matters", "scope", "freshness", "materiality", "consequence", "security", "reversibility", "authority", "budget", "known_facts", "stop_conditions", "escalation_conditions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "knowledge_need_id": { "type": "string", "pattern": "^kn_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "question": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string", "minLength": 1 },
    "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^dec_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "uniqueItems": true },
    "criterion_ids": { "type": "array", "items": { "type": "string", "pattern": "^ac_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "uniqueItems": true },
    "scope": { "$ref": "#/$defs/scope" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "materiality": { "enum": ["low", "medium", "high", "critical"] },
    "consequence": { "enum": ["low", "medium", "high", "critical"] },
    "security": { "enum": ["none", "relevant", "high"] },
    "reversibility": { "enum": ["easy", "moderate", "hard"] },
    "authority": { "$ref": "#/$defs/authority" },
    "budget": { "$ref": "#/$defs/budget" },
    "known_facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "escalation_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "scope": { "type": "object", "additionalProperties": false, "required": ["repository", "dependencies", "versions", "usage", "breadth"], "properties": { "repository": { "type": "string", "minLength": 1 }, "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "usage": { "type": "string", "minLength": 1 }, "breadth": { "enum": ["narrow", "moderate", "broad"] } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["requirement", "as_of"], "properties": { "requirement": { "enum": ["none", "current", "recent", "as_of"] }, "as_of": { "type": ["string", "null"], "format": "date-time" } }, "allOf": [{ "if": { "properties": { "requirement": { "const": "as_of" } }, "required": ["requirement"] }, "then": { "required": ["as_of"], "properties": { "as_of": { "type": "string" } } }, "else": { "properties": { "as_of": { "type": "null" } } } }] },
    "authority": { "type": "object", "additionalProperties": false, "required": ["level", "proof"], "properties": { "level": { "enum": ["repository", "official", "primary", "independent", "human"] }, "proof": { "enum": ["record", "citation", "independent_corroboration", "human_confirmation"] } } },
    "budget": { "type": "object", "additionalProperties": false, "required": ["cost", "context", "max_external_researchers"], "properties": { "cost": { "enum": ["minimal", "bounded", "generous"] }, "context": { "enum": ["minimal", "bounded", "generous"] }, "max_external_researchers": { "type": "integer", "minimum": 0, "maximum": 8 } } }
  }
}
