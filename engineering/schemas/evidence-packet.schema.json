{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-packet.schema.json",
  "title": "Legacy scoped engineering evidence packet (read-only compatibility)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "research_run", "scope", "claims", "sources", "conflicts", "coverage_gaps"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "packet_id": { "type": "string", "pattern": "^epk_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "research_run": { "$ref": "#/$defs/researchRun" },
    "scope": { "$ref": "#/$defs/scope" },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "coverage_gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } }
  },
  "$defs": {
    "researchRun": { "type": "object", "additionalProperties": false, "required": ["run_id", "plan_id", "archive_schema_version", "archive_sha256"], "properties": { "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "plan_id": { "type": "string", "pattern": "^plan_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "archive_schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "archive_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["engineering_question", "selection_rationale", "selected_claim_ids"], "properties": { "engineering_question": { "type": "string", "minLength": 1 }, "selection_rationale": { "type": "string", "minLength": 1 }, "selected_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "relationship"], "properties": { "source_id": { "type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "locator": { "type": "string", "minLength": 1 }, "relationship": { "enum": ["supports", "contradicts", "qualifies"] }, "note": { "type": "string", "minLength": 1 } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "scope", "claim_type", "materiality", "confidence", "confidence_rationale", "supporting_evidence", "counter_evidence", "verification_event_ids"], "properties": { "claim_id": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "statement": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 }, "claim_type": { "enum": ["fact", "source_assertion", "estimate", "opinion", "inference"] }, "materiality": { "enum": ["critical", "high", "medium", "low"] }, "confidence": { "enum": ["high", "medium", "low"] }, "confidence_rationale": { "type": "string", "minLength": 1 }, "supporting_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "counter_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "verification_event_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^ver_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "premise_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" } } }, "allOf": [{ "if": { "properties": { "claim_type": { "const": "inference" } }, "required": ["claim_type"] }, "then": { "required": ["premise_claim_ids"] }, "else": { "not": { "required": ["premise_claim_ids"] } } }] },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "title", "publisher", "publication_date", "source_type", "independence_group"], "properties": { "source_id": { "type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 }, "publication_date": { "type": ["string", "null"] }, "source_type": { "type": "string", "minLength": 1 }, "independence_group": { "type": "string", "pattern": "^ig_[A-Za-z0-9][A-Za-z0-9_-]*$" } } },
    "conflict": { "type": "object", "additionalProperties": false, "required": ["conflict_id", "claim_ids", "supporting_source_ids", "reason", "practical_implication", "status"], "properties": { "conflict_id": { "type": "string", "pattern": "^conf_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "supporting_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "reason": { "type": "string", "minLength": 1 }, "practical_implication": { "type": "string", "minLength": 1 }, "status": { "enum": ["unresolved", "qualified", "resolved"] }, "resolution_rationale": { "type": "string", "minLength": 1 } } },
    "gap": { "type": "object", "additionalProperties": false, "required": ["coverage_gap_id", "description", "severity", "status", "related_subquestion_ids"], "properties": { "coverage_gap_id": { "type": "string", "pattern": "^gap_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "description": { "type": "string", "minLength": 1 }, "severity": { "enum": ["critical", "high", "medium", "low"] }, "status": { "enum": ["open", "partially_addressed", "resolved", "accepted"] }, "related_subquestion_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sq_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "related_claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^clm_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "resolution_rationale": { "type": "string", "minLength": 1 } } }
  }
}
