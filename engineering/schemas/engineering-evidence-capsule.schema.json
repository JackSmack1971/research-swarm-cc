{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-evidence-capsule.schema.json",
  "title": "Engineering Evidence Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capsule_id", "knowledge_need_id", "producer", "applicability", "claims", "sources", "conflicts", "gaps", "freshness", "identity", "limitations", "non_authorizing"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capsule_id": { "type": "string", "pattern": "^eec_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "knowledge_need_id": { "type": "string", "pattern": "^kn_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "producer": { "$ref": "#/$defs/producer" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "freshness": { "$ref": "#/$defs/freshness" },
    "identity": { "$ref": "#/$defs/identity" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "non_authorizing": { "const": true }
  },
  "$defs": {
    "producer": { "type": "object", "additionalProperties": false, "required": ["tier", "mechanism", "evidence_id"], "properties": { "tier": { "enum": ["T1", "T2", "T3", "T4"] }, "mechanism": { "enum": ["authoritative_lookup", "focused_research", "independent_verification", "validated_archive_bridge"] }, "evidence_id": { "type": "string", "minLength": 1 } } },
    "applicability": { "type": "object", "additionalProperties": false, "required": ["repository", "revision", "dependencies", "versions"], "properties": { "repository": { "type": "string", "minLength": 1 }, "revision": { "type": ["string", "null"] }, "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "locator": { "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "relationship"], "properties": { "source_id": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 }, "relationship": { "enum": ["supports", "contradicts", "qualifies", "checked"] }, "note": { "type": "string", "minLength": 1 } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "scope", "materiality", "confidence", "verification", "evidence"], "properties": { "claim_id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 }, "materiality": { "enum": ["critical", "high", "medium", "low"] }, "confidence": { "enum": ["high", "medium", "low"] }, "verification": { "enum": ["confirmed", "confirmed_with_qualification", "contradicted", "demoted", "unverifiable", "not_independently_verified"] }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/locator" } } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "title", "publisher", "retrieved_at", "mechanism", "version_applicability"], "properties": { "source_id": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 }, "retrieved_at": { "type": "string", "format": "date-time" }, "mechanism": { "type": "string", "minLength": 1 }, "version_applicability": { "type": "string", "minLength": 1 } } },
    "conflict": { "type": "object", "additionalProperties": false, "required": ["id", "claim_ids", "summary", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "summary": { "type": "string", "minLength": 1 }, "status": { "enum": ["unresolved", "qualified", "resolved"] } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["retrieved_at", "status", "retrieval_identity"], "properties": { "retrieved_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["current", "recent", "as_of", "unknown", "archive_validated"] }, "retrieval_identity": { "type": "string", "minLength": 1 } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["digest", "lineage"], "properties": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "lineage": { "type": "object", "additionalProperties": false, "required": ["source_evidence_id"], "properties": { "source_evidence_id": { "type": "string", "minLength": 1 }, "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "plan_id": { "type": "string", "pattern": "^plan_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "archive_schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "archive_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } } }
  }
}
