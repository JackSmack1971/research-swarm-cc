{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-manifest.schema.json",
  "title": "Derived delivery handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "status", "accepted_decision_ids", "tasks", "contract", "base_repository", "references", "final_change", "verification", "unresolved", "repair_history", "integration", "next_action"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "delivery_id": { "type": "string", "pattern": "^dlv_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "status": { "enum": ["verified", "not_verified", "blocked", "stopped", "rejected"] },
    "accepted_decision_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^dec_[A-Za-z0-9][A-Za-z0-9_-]*$" } },
    "tasks": { "type": "object", "additionalProperties": false, "required": ["completed", "remaining"], "properties": { "completed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^tsk_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "remaining": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^tsk_[A-Za-z0-9][A-Za-z0-9_-]*$" } } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["contract_id", "sha256"], "properties": { "contract_id": { "type": "string", "pattern": "^chg_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "base_repository": { "$ref": "project-profile.schema.json#/$defs/target" },
    "references": { "type": "array", "minItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": { "kind": { "enum": ["profile", "contract", "graph", "capsule", "authorization", "execution_event", "verification_events", "criterion_proofs"] }, "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)[^\\\\]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "final_change": { "type": "object", "additionalProperties": false, "required": ["execution_event_id", "change_identity", "changed_files"], "properties": { "execution_event_id": { "type": "string", "pattern": "^exe_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "change_identity": { "type": ["string", "null"] }, "changed_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "verification": { "type": "object", "additionalProperties": false, "required": ["status", "repair_rounds", "event_ids", "proof_statuses"], "properties": { "status": { "enum": ["proven", "failed", "blocked", "unverifiable", "not_run"] }, "repair_rounds": { "type": "integer", "minimum": 0, "maximum": 2 }, "event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ver_[A-Za-z0-9][A-Za-z0-9_-]*$" } }, "proof_statuses": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["criterion_id", "proof_id", "status", "rationale"], "properties": { "criterion_id": { "type": "string", "pattern": "^ac_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "proof_id": { "type": "string", "pattern": "^prf_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "status": { "enum": ["proven", "failed", "blocked", "unverifiable"] }, "rationale": { "type": "string", "minLength": 1 } } } } } },
    "unresolved": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "statement"], "properties": { "kind": { "enum": ["risk", "blocker"] }, "statement": { "type": "string", "minLength": 1 } } } },
    "repair_history": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "integration": { "type": "object", "additionalProperties": false, "required": ["status", "statement"], "properties": { "status": { "enum": ["not_applied", "applied", "blocked"] }, "statement": { "type": "string", "minLength": 1 } } },
    "next_action": { "type": "string", "minLength": 1 },
    "evidence_provenance": { "type": "object", "additionalProperties": false, "required": ["kind", "recorded_by"], "properties": { "kind": { "enum": ["synthetic_fixture", "plain_claude_baseline", "live_delivery"] }, "recorded_by": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 } } }
  }
}
