{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-capsule.schema.json",
  "title": "Disposable task context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "objective", "acceptance_criteria", "decisions", "non_goals", "base_repository", "evidence_references", "code_anchors", "verification", "risks", "stop_conditions"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "task_id": { "type": "string", "pattern": "^tsk_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["criterion_id", "requirement_ids", "observable_proof"], "properties": { "criterion_id": { "type": "string" }, "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "observable_proof": { "type": "string" } } } },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "decision.schema.json" } }, "non_goals": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": { "id": { "type": "string", "pattern": "^ng_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "statement": { "type": "string", "minLength": 1 } } } }, "base_repository": { "$ref": "project-profile.schema.json#/$defs/target" }, "evidence_references": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "code_anchors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": { "path": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } } }, "verification": { "type": "object", "additionalProperties": false, "required": ["commands", "proofs"], "properties": { "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "proofs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }, "risks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["risk_id", "dimension", "level", "rationale"], "properties": { "risk_id": { "type": "string", "pattern": "^rsk_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "dimension": { "enum": ["scope", "reversibility", "security", "data", "external_effect", "uncertainty"] }, "level": { "enum": ["low", "medium", "high", "critical"] }, "rationale": { "type": "string", "minLength": 1 } } } }, "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  }
}
