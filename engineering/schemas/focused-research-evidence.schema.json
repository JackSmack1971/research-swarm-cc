{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "focused-research-evidence.schema.json",
  "title": "Tier 2 focused engineering research evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "knowledge_need_id", "scope", "sources", "claims", "unresolved_gaps", "escalation", "budget", "non_authorizing"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "type": "string", "pattern": "^fre_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "knowledge_need_id": { "type": "string", "pattern": "^kn_[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["question", "repository", "dependencies", "versions", "usage"], "properties": { "question": { "type": "string", "minLength": 1 }, "repository": { "type": "string", "minLength": 1 }, "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "usage": { "type": "string", "minLength": 1 } } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "uniqueItems": true },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "uniqueItems": true },
    "unresolved_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "escalation": { "type": "object", "additionalProperties": false, "required": ["required", "tier", "reasons"], "properties": { "required": { "type": "boolean" }, "tier": { "enum": ["none", "T3", "T4"] }, "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "budget": { "type": "object", "additionalProperties": false, "required": ["max_sources", "max_claims", "max_web_fetches", "used_sources", "used_claims", "used_web_fetches"], "properties": { "max_sources": { "type": "integer", "minimum": 1, "maximum": 8 }, "max_claims": { "type": "integer", "minimum": 1, "maximum": 8 }, "max_web_fetches": { "type": "integer", "minimum": 1, "maximum": 16 }, "used_sources": { "type": "integer", "minimum": 0 }, "used_claims": { "type": "integer", "minimum": 0 }, "used_web_fetches": { "type": "integer", "minimum": 0 } } },
    "non_authorizing": { "const": true }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "title", "publisher", "publication_date", "publication_unavailable_reason", "locator", "source_type", "accessed_at", "independence_group", "version_applicability"], "properties": { "source_id": { "type": "string", "pattern": "^frs_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 }, "publication_date": { "type": ["string", "null"], "format": "date-time" }, "publication_unavailable_reason": { "type": ["string", "null"] }, "locator": { "type": "string", "minLength": 1 }, "source_type": { "enum": ["official_documentation", "official_release", "standard", "vendor_advisory", "primary_research", "primary_data", "independent_analysis"] }, "accessed_at": { "type": "string", "format": "date-time" }, "independence_group": { "type": "string", "minLength": 1 }, "version_applicability": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "publication_date": { "type": "null" } } }, "then": { "required": ["publication_unavailable_reason"], "properties": { "publication_unavailable_reason": { "type": "string", "minLength": 1 } } }, "else": { "properties": { "publication_unavailable_reason": { "type": "null" } } } }] },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["source_id", "locator"], "properties": { "source_id": { "type": "string", "pattern": "^frs_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "locator": { "type": "string", "minLength": 1 } } },
    "counter": { "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "summary"], "properties": { "source_id": { "type": "string", "pattern": "^frs_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "locator": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "scope", "claim_type", "confidence", "confidence_rationale", "supporting_evidence", "counter_evidence"], "properties": { "claim_id": { "type": "string", "pattern": "^frc_[A-Za-z0-9][A-Za-z0-9_-]*$" }, "statement": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 }, "claim_type": { "enum": ["fact", "source_assertion", "estimate", "inference"] }, "confidence": { "enum": ["high", "medium", "low"] }, "confidence_rationale": { "type": "string", "minLength": 1 }, "supporting_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "counter_evidence": { "type": "array", "items": { "$ref": "#/$defs/counter" } } } }
  }
}
